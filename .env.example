# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit real secrets.
# The publishable (anon) key is safe for the browser when RLS is enabled.
# Do not put the service role key in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the current dashboard name. Legacy ANON_KEY still works as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for absolute redirects in OAuth, email confirmation, and password reset
NEXT_PUBLIC_SITE_URL=http://localhost:3000
