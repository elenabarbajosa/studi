# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit real secrets. The anon key is safe for the browser when RLS is enabled.
# Do not put the service role key in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used for absolute redirects in OAuth / email confirmation locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000
