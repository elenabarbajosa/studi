# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit real secrets.
# The publishable (anon) key is safe for the browser when RLS is enabled.
# Do not put the service role key in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the current dashboard name. Legacy ANON_KEY still works as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for absolute redirects in OAuth, email confirmation, and password reset
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (server-only). Never expose as NEXT_PUBLIC_*.
# GEMINI_API_KEY=your-gemini-api-key

# Owner AI daily limit (server-only). Must be the Supabase Auth user UUID for
# elenabarbajosa@gmail.com — not the email itself. Look it up in the Dashboard
# (Authentication → Users) or via SQL as a project admin:
#   select id, email from auth.users where email = 'elenabarbajosa@gmail.com';
# Keep in sync with public.studi_ai_owner.owner_user_id after migration 013.
# STUDI_OWNER_USER_ID=00000000-0000-4000-8000-000000000000

# Grades & What-If (migration 017_grades.sql):
# - subject_grade_schemes, grade_groups, grade_components with RLS
# - What-If scenarios are session-local only (never written as actual scores)
# - Cross-subject average only when all graded subjects share the same scale

# Canvas course importer (migration 016_canvas_materials_storage.sql):
# - Private buckets: course-materials (≤20 MB/file), canvas-staging (≤25 MB archives)
# - Browser uploads archives to canvas-staging; Server Actions only receive the path
#   (Next.js Server Action bodies default to 1 MB — ZIP bytes never go through them)
# - Free-tier Supabase storage (~1 GB) and Vercel execution-time limits apply
# - Feature id for AI organization: canvas_classify (separate daily quota)

# ---------------------------------------------------------------------------
# External calendar integrations (migration 018_external_calendars.sql)
# ---------------------------------------------------------------------------
# AES-256-GCM key for provider tokens / iCloud app-specific passwords.
# Generate: openssl rand -hex 32
# STUDI_CALENDAR_SECRETS_KEY=
#
# Service role (server-only): required to read/write encrypted secrets and OAuth
# state after migration 019. Never put this in NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar API (OAuth web client — separate from Supabase Google login)
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/calendar/oauth/google/callback
# Enable Google Calendar API; scope calendar.readonly. Verification may be pending.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Graph / Entra ID app registration
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/calendar/oauth/microsoft/callback
# Account types: personal + work/school (tenant=common). Permission: Calendars.Read
# (delegated). Do not request Mail.Read.
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_TENANT=common

# iCloud: no cloud OAuth client id. Students use Apple Account email +
# app-specific password (account.apple.com). Requires STUDI_CALENDAR_SECRETS_KEY.

# Scheduled sync (Vercel cron in vercel.json defaults to daily — Hobby limit).
# On Pro, change schedule to "*/15 * * * *". Authorize with:
# CALENDAR_SYNC_CRON_SECRET=
# (Also requires SUPABASE_SERVICE_ROLE_KEY above.)
# Until cron secret + service role are set and verified, only manual "Sync now" is active.
